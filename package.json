{
  "name": "giusecoder-ide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev:client\" \"npm run dev:server\" \"npx tsx electron/main.ts\"",
    "electron:build": "npm run build && npx esbuild electron/main.ts --bundle --platform=node --outfile=electron/main.cjs --external:electron --format=cjs && npx esbuild electron/preload.ts --bundle --platform=node --outfile=electron/preload.cjs --external:electron --format=cjs",
    "electron:package": "npm run electron:build && npx electron-builder --win"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.38.0",
    "@monaco-editor/react": "^4.7.0",
    "@openai/codex-sdk": "^0.101.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^2.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vercel/node": "^5.6.3",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0",
    "esbuild": "^0.27.3",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
